{
  "name": "austin-notify-console",
  "version": "2.0.0",
  "private": true,
  "description": "Austin Notify Vue 3 message operations console",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "start": "node server.js",
    "test": "vue-tsc -b --pretty false"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "express": "^5.1.0",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
