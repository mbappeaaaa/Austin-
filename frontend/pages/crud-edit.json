{
  "type": "page",
  "title": "编辑消息模板",
  "body": [
    {
      "type": "form",
      "name": "templateEditForm",
      "mode": "horizontal",
      "affixFooter": true,
      "redirect": "/crud/list?page=1",
      "initApi": {
        "method": "get",
        "url": "${ls:backend_url}/messageTemplate/query/${params.id}",
        "adaptor": "var data = payload.data || {}; data.webhookBody = data.body || ''; data.accountAvailabilityStatus = data.channelAvailabilityStatus; data.accountAvailabilityMessage = data.channelAvailabilityMessage; return {status: payload.status, msg: payload.msg, data: data};"
      },
      "body": [
        {
          "type": "alert",
          "level": "danger",
          "showIcon": true,
          "visibleOn": "this.channelReady === false",
          "body": "${channelAvailabilityMessage || '渠道已禁用或账号未配置'}。历史模板仍可查看，但不能再次提交、测试发送或启动任务。"
        },
        {
          "type": "fieldSet",
          "title": "基本配置",
          "body": [
            {"type": "input-text", "name": "name", "label": "模板名称", "required": true},
            {"type": "input-text", "name": "proposer", "label": "模板业务方"},
            {
              "type": "radios",
              "name": "msgType",
              "label": "消息类型",
              "required": true,
              "options": [{"label": "通知类", "value": "10"}, {"label": "营销类", "value": "20"}, {"label": "验证码", "value": "30"}]
            },
            {
              "type": "radios",
              "name": "shieldType",
              "label": "屏蔽类型",
              "required": true,
              "options": [{"label": "夜间不屏蔽", "value": "10"}, {"label": "夜间屏蔽", "value": "20"}, {"label": "夜间屏蔽（次日 9 点发送）", "value": "30"}]
            },
            {
              "type": "radios",
              "name": "templateType",
              "label": "模板类型",
              "required": true,
              "options": [{"label": "定时", "value": "10"}, {"label": "实时", "value": "20"}]
            },
            {"type": "input-text", "name": "expectPushTime", "label": "Cron 表达式", "visibleOn": "this.templateType == 10", "requiredOn": "this.templateType == 10", "clearValueOnHidden": false},
            {"type": "input-text", "name": "cronCrowdPath", "label": "人群文件路径", "visibleOn": "this.templateType == 10", "readOnly": true}
          ]
        },
        {
          "type": "fieldSet",
          "title": "渠道与账号",
          "body": [
            {
              "type": "select",
              "name": "sendChannel",
              "label": "发送渠道",
              "required": true,
              "disabled": true,
              "source": {
                "method": "get",
                "url": "${ls:backend_url}/channel/list?creator=${ls:openId}&includeDisabled=true",
                "adaptor": "return {status: payload.status, msg: payload.msg, data: (payload.data || []).map(function(item) { return {label: item.name, value: String(item.code), disabled: item.enabled !== true}; })};"
              }
            },
            {"type": "static", "name": "sendAccount", "label": "发送账号", "visibleOn": "this.sendChannel != 10"},
            {"type": "static", "value": "0（IM 固定账号）", "label": "发送账号", "visibleOn": "this.sendChannel == 10"},
            {
              "type": "tpl",
              "visibleOn": "this.channelReady === false",
              "tpl": "<span class=\"label label-danger\">${channelAvailabilityStatus}</span> <span class=\"text-danger\">${channelAvailabilityMessage}</span>"
            }
          ]
        },
        {
          "type": "fieldSet",
          "title": "消息内容",
          "body": [
            {"type": "input-text", "name": "title", "label": "标题", "visibleOn": "this.sendChannel == 10 || this.sendChannel == 40", "requiredOn": "this.sendChannel == 10 || this.sendChannel == 40"},
            {"type": "textarea", "name": "content", "label": "正文", "visibleOn": "this.sendChannel == 10 || this.sendChannel == 30 || this.sendChannel == 40 || this.sendChannel == 110", "requiredOn": "this.sendChannel == 10 || this.sendChannel == 30 || this.sendChannel == 40 || this.sendChannel == 110", "minRows": 6},
            {"type": "input-text", "name": "url", "label": "跳转链接", "visibleOn": "this.sendChannel == 10 || this.sendChannel == 40 || this.sendChannel == 110"},
            {
              "type": "editor",
              "name": "webhookBody",
              "label": "Webhook JSON Body",
              "visibleOn": "this.sendChannel == 130",
              "requiredOn": "this.sendChannel == 130",
              "language": "json",
              "size": "xl",
              "validations": {"isJson": true},
              "validationErrors": {"isJson": "Body 必须是合法 JSON"}
            },
            {"type": "json", "name": "msgContent", "label": "原始模板内容", "visibleOn": "this.sendChannel != 10 && this.sendChannel != 30 && this.sendChannel != 40 && this.sendChannel != 110 && this.sendChannel != 130"}
          ]
        }
      ],
      "actions": [
        {"type": "button", "label": "返回", "actionType": "link", "link": "/crud/list"},
        {"type": "submit", "label": "保存", "level": "primary", "disabledOn": "this.channelReady !== true", "tooltip": "渠道或账号不可用时禁止再次提交"}
      ],
      "api": {
        "method": "post",
        "url": "${ls:backend_url}/messageTemplate/save",
        "data": {
          "id": "${id}", "name": "${name}", "proposer": "${proposer}", "msgType": "${msgType}", "shieldType": "${shieldType}", "templateType": "${templateType}", "expectPushTime": "${expectPushTime}", "cronCrowdPath": "${cronCrowdPath}", "creator": "${creator}", "sendChannel": "${sendChannel}", "sendAccount": "${sendAccount}", "title": "${title}", "content": "${content}", "url": "${url}", "webhookBody": "${webhookBody}", "msgStatus": "${msgStatus}", "flowId": "${flowId}", "auditStatus": "${auditStatus}", "isDeleted": "${isDeleted}"
        },
        "requestAdaptor": "var channel = Number(api.data.sendChannel); var content = {}; if (channel === 10) { api.data.sendAccount = 0; api.data.idType = 10; content = {title: api.data.title || '', content: api.data.content || '', url: api.data.url || ''}; } else if (channel === 30) { api.data.idType = 30; content = {content: api.data.content || ''}; } else if (channel === 40) { api.data.idType = 50; content = {title: api.data.title || '', content: api.data.content || '', url: api.data.url || ''}; } else if (channel === 110) { api.data.idType = 10; content = {content: api.data.content || '', url: api.data.url || '', sendType: '10'}; } else if (channel === 130) { api.data.idType = 10; var body; try { body = JSON.parse(api.data.webhookBody); } catch (ignore) { throw new Error('Webhook Body 必须是合法 JSON'); } if (!body || typeof body !== 'object') { throw new Error('Webhook Body 必须是 JSON 对象或数组'); } content = {body: JSON.stringify(body)}; } else { throw new Error('个人开发者版未提供该渠道的模板编辑器'); } api.data.msgContent = JSON.stringify(content); delete api.data.title; delete api.data.content; delete api.data.url; delete api.data.webhookBody; return api;"
      }
    }
  ]
}
