{
  "type": "page",
  "title": "用户与角色",
  "subTitle": "角色权限由服务端统一维护，用户停用后无法再登录",
  "body": [
    {
      "type": "crud",
      "name": "userCrud",
      "api": {
        "method": "get",
        "url": "${ls:backend_url}/auth/users",
        "adaptor": "return {status: payload.status, msg: payload.msg, data: {count: (payload.data || []).length, rows: payload.data || []}};"
      },
      "syncLocation": false,
      "headerToolbar": [
        {
          "type": "button",
          "label": "创建用户",
          "level": "primary",
          "actionType": "dialog",
          "dialog": {
            "title": "创建用户",
            "body": {
              "type": "form",
              "api": "post:${ls:backend_url}/auth/users",
              "reload": "userCrud",
              "body": [
                {"type": "input-text", "name": "username", "label": "用户名", "required": true, "validations": {"matchRegexp": "/^[A-Za-z0-9._-]{3,64}$/"}},
                {"type": "input-text", "name": "displayName", "label": "显示名称", "required": true, "maxLength": 64},
                {
                  "type": "input-password",
                  "name": "password",
                  "label": "初始密码",
                  "required": true,
                  "placeholder": "请输入 8-72 位密码",
                  "validations": {"minLength": 8, "maxLength": 72},
                  "validationErrors": {
                    "minLength": "密码至少需要 8 位",
                    "maxLength": "密码最多允许 72 位"
                  }
                },
                {
                  "type": "select",
                  "name": "role",
                  "label": "角色",
                  "required": true,
                  "source": {"method": "get", "url": "${ls:backend_url}/auth/users/roles", "adaptor": "return {status: payload.status, msg: payload.msg, data: payload.data || []};"}
                }
              ]
            }
          }
        },
        "reload"
      ],
      "columns": [
        {"name": "id", "label": "ID", "width": 70},
        {"name": "username", "label": "用户名"},
        {"name": "displayName", "label": "显示名称"},
        {
          "name": "role",
          "label": "角色",
          "type": "mapping",
          "map": {"ADMIN": "系统管理员", "OPERATOR": "运营人员", "AUDITOR": "审计人员", "USER": "普通用户"}
        },
        {"name": "enabled", "label": "状态", "type": "status", "map": {"true": 1, "false": 0}},
        {
          "type": "operation",
          "label": "操作",
          "buttons": [
            {
              "type": "button",
              "label": "编辑",
              "level": "link",
              "actionType": "dialog",
              "dialog": {
                "title": "编辑用户 · ${username}",
                "body": {
                  "type": "form",
                  "api": {"method": "put", "url": "${ls:backend_url}/auth/users/${id}"},
                  "reload": "userCrud",
                  "body": [
                    {"type": "static", "name": "username", "label": "用户名"},
                    {"type": "input-text", "name": "displayName", "label": "显示名称", "required": true, "maxLength": 64},
                    {"type": "select", "name": "role", "label": "角色", "required": true, "source": {"method": "get", "url": "${ls:backend_url}/auth/users/roles", "adaptor": "return {status: payload.status, msg: payload.msg, data: payload.data || []};"}},
                    {"type": "switch", "name": "enabled", "label": "启用"}
                  ]
                }
              }
            },
            {
              "type": "button",
              "label": "重置密码",
              "level": "link",
              "actionType": "dialog",
              "dialog": {
                "title": "重置密码 · ${username}",
                "body": {
                  "type": "form",
                  "api": {"method": "put", "url": "${ls:backend_url}/auth/users/${id}/password"},
                  "body": [
                    {
                      "type": "input-password",
                      "name": "password",
                      "label": "新密码",
                      "required": true,
                      "placeholder": "请输入 8-72 位密码",
                      "validations": {"minLength": 8, "maxLength": 72},
                      "validationErrors": {
                        "minLength": "密码至少需要 8 位",
                        "maxLength": "密码最多允许 72 位"
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
